{
  "version": 1,
  "project": "pathlight",
  "mappings": [
    { "glob": "plugins/**", "element": "plugin" },
    { "glob": "src/claude.ts", "element": "plugin" },
    { "glob": "src/{activity,activity-subscriptions,layout,sessions}.ts", "element": "activity" },
    { "glob": "src/ask.ts", "element": "ask" },
    { "glob": "src/catalog.ts", "element": "catalog" },
    { "glob": "src/{cli,init,doctor,setup,tmux,process,ready,see,pane}.ts", "element": "launcher" },
    { "glob": "npm/**", "element": "launcher" },
    { "glob": "src/{native-viewer,flow-view,routes,ui,node-files,editor,fuzzy,search,conversation}.ts", "element": "viewer" },
    { "glob": "src/viewer/**", "element": "viewer" },
    { "glob": "src/{scan,scan-imports,check,draft,brief,starts,stale,diff,plan,point,review,edit,flows,flow-write,resources}.ts", "element": "scanner" },
    { "glob": "src/languages/**", "element": "scanner" },
    { "glob": "src/resources/**", "element": "scanner" },
    { "glob": "src/{theme,retheme}.ts", "element": "themes" },
    { "glob": "src/themes/**", "element": "themes" },
    { "glob": "src/web/**", "element": "browser" },
    { "glob": "web/**", "element": "browser" },
    { "glob": "src/page/**", "element": "browser" },
    { "glob": "scripts/{pack-web,web-fixture,build-page}.ts", "element": "browser" }
  ],
  "ignore": ["tests/**", "src/effects.ts", "src/assets.d.ts", "scripts/ansi2png.py"]
}
