{
  "version": 1,
  "project": "pathlight",
  "mappings": [
    { "glob": "plugins/**", "element": "plugin" },
    { "glob": "src/claude.ts", "element": "plugin" },
    { "glob": "src/{activity,activity-subscriptions,layout}.ts", "element": "activity" },
    { "glob": "src/ask.ts", "element": "ask" },
    { "glob": "src/catalog.ts", "element": "catalog" },
    { "glob": "src/{cli,init,doctor,setup,tmux,process,ready,see}.ts", "element": "launcher" },
    { "glob": "src/{native-viewer,flow-view,routes,ui,node-files,editor,fuzzy,search}.ts", "element": "viewer" },
    { "glob": "src/{scan,scan-imports,check,draft,brief,stale,diff,plan,edit,flows,flow-write}.ts", "element": "scanner" },
    { "glob": "src/{theme,retheme}.ts", "element": "themes" },
    { "glob": "src/themes/**", "element": "themes" }
  ],
  "ignore": ["tests/**", "src/effects.ts", "src/assets.d.ts"]
}
