specification {
  element component
}

model {
  plugin = component 'Agent adapters' {
    technology 'Claude hooks, OpenCode plugin'
    description 'Observe each tool call an agent makes and record only its lifecycle: tool, operation, files named, and when.'
  }
  activity = component 'Activity metadata' {
    technology 'JSON journal'
    description 'Bounded, local, per-session event journal. Holds metadata only: never source, arguments, commands or results.'
  }
  catalog = component 'LikeC4 catalog' {
    technology 'LikeC4'
    description 'Loads the architecture model and its layout. LikeC4 stays the source of truth for identities, hierarchy and links.'
  }
  launcher = component 'tmux launcher' {
    technology 'tmux, Bun'
    description 'Opens, reuses and cleans up the viewer pane beside the conversation. Never touches a pane it does not own.'
  }
  viewer = component 'Persistent viewer' {
    technology 'OpenTUI, Three'
    description 'The interactive diagram: pan and zoom camera, node selection, mapped files, and live activity.'
  }

  ask = component 'Ask bridge' {
    technology 'tmux send-keys'
    description 'Types a question about a component, with its files and connections, into the agent pane the viewer was opened beside. Typed, not sent, unless you ask.'
  }

  scanner = component 'Scanner and checker' {
    technology 'Bun, Effect'
    description 'Reads TypeScript and JavaScript statically (files, imports, what it could not read), checks the model and file mapping against that scan, compares the relationships it supports with a git commit, and draws a first picture from it. Static evidence only: it never claims anything about what runs.'
  }

  themes = component 'Themes' {
    technology 'JSON, Effect Schema'
    description 'Colour themes in OpenCode format (bundled, yours, or taken from the terminal), resolved to the palette the viewer draws with and applied live.'
  }

  viewer -> ask 'Hands a question over'
  viewer -> themes 'Applies the palette'
  plugin -> activity 'Records tool lifecycle'
  plugin -> launcher 'Opens a view'
  launcher -> catalog 'Selects the view'
  launcher -> scanner 'Runs scan and check'
  scanner -> catalog 'Reads the model'
  scanner -> activity 'Reads the file mapping'
  catalog -> activity 'Validates the mapping against the model'
  launcher -> activity 'Reads and writes the journal'
  viewer -> catalog 'Reloads the model'
  viewer -> scanner 'Shows the last check and diff'
  ask -> launcher 'Runs tmux through its process runner'
  launcher -> viewer 'Starts owned pane'
  activity -> viewer 'Updates component activity'
}

views {
  view live {
    title 'Pathlight implementation'
    include *
    autoLayout LeftRight
  }
}
