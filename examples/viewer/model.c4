specification {
  element component
}

model {
  plugin = component 'Agent adapters' {
    technology 'Claude hooks, OpenCode plugin'
    description 'Observe each tool call an agent makes and record only its lifecycle: tool, operation, files named, and when.'
  }
  activity = component 'Activity metadata' {
    technology 'JSON journal'
    description 'Bounded, local, per-session event journal. Holds metadata only: never source, arguments, commands or results.'
  }
  catalog = component 'LikeC4 catalog' {
    technology 'LikeC4'
    description 'Loads the architecture model and its layout. LikeC4 stays the source of truth for identities, hierarchy and links.'
  }
  launcher = component 'tmux launcher' {
    technology 'tmux, Bun'
    description 'Opens, reuses and cleans up the viewer pane beside the conversation. Never touches a pane it does not own.'
  }
  viewer = component 'Persistent viewer' {
    technology 'OpenTUI, Three'
    description 'The interactive diagram: pan and zoom camera, node selection, mapped files, and live activity.'
  }

  plugin -> activity 'Records tool lifecycle'
  plugin -> launcher 'Opens a view'
  catalog -> launcher 'Selects diagram'
  launcher -> viewer 'Starts owned pane'
  activity -> viewer 'Updates component activity'
}

views {
  view live {
    title 'Visualize work implementation'
    include *
    autoLayout LeftRight
  }
}
